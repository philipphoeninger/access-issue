{
  "name": "access-issue",
  "version": "1.0.0",
  "description": "AccessIssue is an accessibility visualization tool for the Blinden- und Sehbehindertenverein Hamburg (BSVH). It allows users to visualize accessible and non-accessible interfaces and processes.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/philipphoeninger/access-issue.git"
  },
  "author": "Philipp Höninger",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/philipphoeninger/access-issue/issues"
  },
  "homepage": "https://github.com/philipphoeninger/access-issue#readme",
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.8",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.27",
    "@angular/router": "^20.3.0",
    "@ngrx/signals": "^20.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.3.33",
    "@angular-eslint/builder": "^20.1.0",
    "@angular-eslint/eslint-plugin": "^20.1.0",
    "@angular-eslint/eslint-plugin-template": "^20.1.0",
    "@angular-eslint/template-parser": "^20.1.0",
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20.3.33",
    "@angular/compiler-cli": "^20.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.56.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^20.1.0",
    "eslint": "^9.22.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "puppeteer": "^25.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.26.0"
  }
}
